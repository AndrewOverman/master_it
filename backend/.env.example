APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

# Minutes until an issued Sanctum token expires. Defaults to 14 days if unset.
# SANCTUM_EXPIRATION=20160

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# Optional: without this, plan steps are generated with no videos attached.
YOUTUBE_API_KEY=

# Max articles/web pages searched per step. Defaults to 1 if unset.
MAX_RESOURCES_PER_STEP=1

# Must match the Authorization header value configured in the RevenueCat
# dashboard under Project settings > Integrations > Webhooks.
REVENUECAT_WEBHOOK_SECRET=

# The SECRET API key from Project settings > API keys — NOT one of the public
# SDK keys the mobile app ships with. Used to verify entitlements server-side
# so a client can't grant itself a paid tier. Leave blank and the refresh
# endpoint degrades to a no-op, which is the intended dev/staging behaviour.
REVENUECAT_SECRET_API_KEY=

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Mail goes out through Resend — MAIL_MAILER, RESEND_API_KEY and MAIL_FROM_*
# are set together at the bottom of this file. The values below are only read
# by the `smtp` mailer, which isn't in use.
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null

# Scheme for the mobile build this backend talks to, used to deep-link
# password-reset emails (masterit / masterit-staging / masterit-dev).
MOBILE_APP_SCHEME=masterit

# App Store listing for the shared-plan web landing page's "Get the app"
# link. Leave blank until there's a real listing — the page omits that
# link entirely rather than show a dead one.
APP_STORE_URL=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

MAIL_MAILER=resend
RESEND_API_KEY=re_...
MAIL_FROM_ADDRESS="onboarding@resend.dev"
MAIL_FROM_NAME="Master It"
# Error reporting. Blank disables it entirely, which is what local and CI
# runs want — nothing is sent and nothing fails for the lack of a DSN.
SENTRY_LARAVEL_DSN=
# Errors only. Performance tracing burns the free quota answering a question
# nobody is asking yet; raise it when there's a latency problem to measure.
SENTRY_TRACES_SAMPLE_RATE=0
# Off deliberately: PII here means IP addresses and request bodies, and
# request bodies on this app contain the user's goal text.
SENTRY_SEND_DEFAULT_PII=false

# Push notifications, delivered via Expo's push service. Off by default so a
# dev or staging backend sharing a database can't fire real notifications at
# devices registered by another environment — leave blank locally.
EXPO_PUSH_ENABLED=false
# Optional (expo.dev > Account settings > Access tokens). Without it, Expo
# accepts pushes to any token from anyone holding it. Set in production.
EXPO_ACCESS_TOKEN=
