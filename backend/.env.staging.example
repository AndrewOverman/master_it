# Staging environment template.
#
# This file documents which vars the "staging" Railway environment needs and
# what they should be set to. It is NOT read by the app — enter the real
# values (including secrets) directly into Railway's environment variable
# UI for the staging environment's `api` and `worker` services. Never commit
# real secret values.
#
# Start from backend/.env.example and apply these overrides.

APP_NAME="Master It (Staging)"
APP_ENV=staging
APP_KEY=
APP_DEBUG=false
APP_URL=https://<staging-api-domain>.up.railway.app

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=info

# Staging deliberately shares dev's Supabase project (same one as local
# backend/.env) rather than getting its own — a deviation from full
# per-environment isolation, chosen knowingly. This means a destructive
# local action (migrate:fresh, a bad test run against this DB) can affect
# staging data. Production is a separate, isolated project — see
# .env.production.example.
DB_CONNECTION=pgsql
DB_HOST=aws-0-ca-central-1.pooler.supabase.com
DB_PORT=5432
DB_DATABASE=postgres
DB_USERNAME=postgres.xzrcfecakrstfskavdpy
DB_PASSWORD=
DB_SSLMODE=require

SESSION_DRIVER=database
SESSION_LIFETIME=120

QUEUE_CONNECTION=database
CACHE_STORE=database

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

YOUTUBE_API_KEY=
MAX_RESOURCES_PER_STEP=1

# The staging EAS build profile sets APP_VARIANT=staging, whose scheme is
# masterit-staging (see app.config.ts / eas.json).
MOBILE_APP_SCHEME=masterit-staging

# Real sending, or password resets and email verifications silently go
# nowhere. The onboarding@resend.dev sandbox sender only delivers to the
# Resend account owner — fine while staging is just us, but swap it for an
# address on a verified domain before anyone else tests against staging.
MAIL_MAILER=resend
RESEND_API_KEY=re_...
MAIL_FROM_ADDRESS="onboarding@resend.dev"
MAIL_FROM_NAME="Master It"