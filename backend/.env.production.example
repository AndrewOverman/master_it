# Production environment template.
#
# This file documents which vars the "production" Railway environment needs
# and what they should be set to. It is NOT read by the app — enter the real
# values (including secrets) directly into Railway's environment variable UI
# for the production environment's `api` and `worker` services. Never commit
# real secret values.
#
# Start from backend/.env.example and apply these overrides.

APP_NAME="Master It"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://<production-api-domain>.up.railway.app

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=warning

# Production's own Supabase project — fully isolated from staging and dev.
# Use the session pooler connection string, same shape as local dev.
DB_CONNECTION=pgsql
DB_HOST=<production-project>.pooler.supabase.com
DB_PORT=5432
DB_DATABASE=postgres
DB_USERNAME=<production-pooler-username>
DB_PASSWORD=
DB_SSLMODE=require

SESSION_DRIVER=database
SESSION_LIFETIME=120

QUEUE_CONNECTION=database
CACHE_STORE=database

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

YOUTUBE_API_KEY=
MAX_RESOURCES_PER_STEP=1

MAIL_MAILER=log
