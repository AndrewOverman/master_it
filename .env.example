# Mobile app environment. Copy to .env for local development.
#
# Only EXPO_PUBLIC_-prefixed variables reach the app bundle, and everything
# that does is readable by anyone with the .ipa — so only publishable keys
# belong here. Secrets (RevenueCat's secret API key, Sentry's auth token,
# every provider key the backend uses) live in backend/.env or in EAS/Railway,
# never in this file.
#
# Per-build values for staging and production are set in eas.json instead.

# Where the Laravel API lives. A LAN IP rather than localhost for local dev,
# so a phone or simulator on the same network can reach the machine.
EXPO_PUBLIC_API_URL=http://localhost:8000

# RevenueCat public SDK keys, per platform. Blank disables purchases entirely:
# the paywall renders its "plans aren't available" state instead of crashing,
# which is what dev and staging builds without a RevenueCat project get.
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=

# PostHog project key (write-only — it can send events, not read them back).
# Blank disables analytics; every track() call becomes a no-op.
EXPO_PUBLIC_POSTHOG_KEY=
# Defaults to https://us.i.posthog.com. Set to https://eu.i.posthog.com for
# EU-resident data, or a self-hosted instance.
EXPO_PUBLIC_POSTHOG_HOST=

# Sentry DSN for the mobile app. Blank disables reporting, and errors fall
# back to the console. Note the SDK also skips sending in __DEV__ regardless,
# so a DSN set locally still won't produce noise from your own dev builds.
EXPO_PUBLIC_SENTRY_DSN=

# Tags error reports so a staging crash can be told apart from a production
# one. Set per build profile in eas.json; defaults to 'production' when unset.
EXPO_PUBLIC_ENVIRONMENT=development
